FROM node:20

# Рабочая директория
WORKDIR /app

# Копируем только package.json и lock-файл (ускоряет сборку)
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем весь проект
COPY . .

# По умолчанию Vite слушает localhost — нам нужно 0.0.0.0
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]