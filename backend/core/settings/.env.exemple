# Настройки используются для локального запуска
# Секретный ключ
# Ключ можно сгенерировать тут https://djecrety.ir/
SECRET_KEY='#'

# Данные БД
DB_NAME=# # указывается имя БД
DB_USER=# # указывается имя пользователя
DB_PASSWORD=# # указывается пароль
DB_HOST=# # указывается хост, где работает база
DB_PORT=# # указывается порт

# URL фронтенда для CORS и других настроек
FRONTEND_URL=# # указывается URL фронтенда

# Настройки для отправки почты
DEFAULT_FROM_EMAIL=# # указывается адрес электронной почты, с которого будут отправляться письма
EMAIL_HOST=# # указывается SMTP-сервер для отправки почты
EMAIL_HOST_USER=# # указывается имя пользователя для SMTP-сервера
EMAIL_HOST_PASSWORD=# # указывается пароль для SMTP-сервера